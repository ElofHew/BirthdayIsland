<ci:SettingsPageBase x:Class="BirthdayIsland.Views.SettingsPages.BirthdaySettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:models="clr-namespace:BirthdayIsland.Models"
                     xmlns:vm="clr-namespace:BirthdayIsland.ViewModels"
                     x:DataType="vm:BirthdaySettingsPageViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="16">

            <TextBlock Text="生日显示插件" FontSize="22" FontWeight="Bold" />

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="导入表格" Command="{Binding ImportExcelCommand}" />
                <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" />
                <Button Content="清空数据" Command="{Binding ClearCommand}" />
                <Button Content="刷新" Command="{Binding ReloadCommand}" />
            </StackPanel>

            <!-- 状态提示 -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource SystemAccentColor}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- 当前数据概览 -->
            <Border BorderThickness="1" CornerRadius="6" Padding="12"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="当前数据" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalCount, StringFormat='总人数：{0}'}" />
                    <TextBlock Text="{Binding TodayBirthdayCount, StringFormat='今日生日人数：{0}'}" />
                    <TextBlock Text="{Binding LastImportFileName, StringFormat='上次导入文件：{0}'}" />
                    <TextBlock Text="{Binding LastImportTimeText, StringFormat='上次导入时间：{0}'}" />
                </StackPanel>
            </Border>

            <!-- 定时提醒 -->
            <Border BorderThickness="1" CornerRadius="6" Padding="12"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <TextBlock Text="定时提醒" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ReminderSummary}" Opacity="0.7"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- 驱动方式：两条路都能发提醒，同时开就会同一分钟各发一条，所以让用户显式选一套 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="提醒由谁控制" VerticalAlignment="Center" Width="96" />
                        <ComboBox Width="200"
                                  ItemsSource="{Binding ReminderSourceLabels}"
                                  SelectedIndex="{Binding SelectedReminderSourceIndex}" />
                    </StackPanel>

                    <TextBlock Text="已交给 ClassIsland 自动化：插件不再按时间自动发提醒，请用「生日提醒触发时」「发送生日提醒」等自动化编排；下面的开关与时间不生效，时长和生日歌设置仍然有效。"
                               Opacity="0.6" TextWrapping="Wrap"
                               IsVisible="{Binding IsAutomationControlled}" />

                    <ToggleSwitch Content="每天在指定时间发送生日提醒"
                                  IsEnabled="{Binding IsPluginControlled}"
                                  IsChecked="{Binding Reminder.IsEnabled}" />

                    <StackPanel Spacing="6">

                        <!-- 提醒时刻：只在「插件设置」模式且已启用时有意义 -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsEnabled="{Binding IsTimeSettingsEnabled}">
                            <TextBlock Text="提醒时间" VerticalAlignment="Center" Width="72" />
                            <NumericUpDown Minimum="0" Maximum="23" Increment="1"
                                           FormatString="00"
                                           Width="140"
                                           HorizontalContentAlignment="Left"
                                           Value="{Binding Reminder.Hour}" />
                            <TextBlock Text=":" VerticalAlignment="Center" />
                            <NumericUpDown Minimum="0" Maximum="59" Increment="1"
                                           FormatString="00"
                                           Width="140"
                                           HorizontalContentAlignment="Left"
                                           Value="{Binding Reminder.Minute}" />
                            <TextBlock Text="（时 / 分）" VerticalAlignment="Center" Opacity="0.6" />
                        </StackPanel>

                        <!-- 时长 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="正文时长" VerticalAlignment="Center" Width="72" />
                            <ComboBox Width="120"
                                      ItemsSource="{Binding NotificationDurationOptions}"
                                      SelectedItem="{Binding Reminder.NotificationDurationSeconds}" />
                            <TextBlock Text="秒" VerticalAlignment="Center" Opacity="0.6" />

                            <TextBlock Text="遮罩时长" VerticalAlignment="Center" Width="72" Margin="16,0,0,0" />
                            <ComboBox Width="120"
                                      ItemsSource="{Binding MaskDurationOptions}"
                                      SelectedItem="{Binding Reminder.MaskDurationSeconds}" />
                            <TextBlock Text="秒" VerticalAlignment="Center" Opacity="0.6" />
                        </StackPanel>

                        <Separator Margin="0,4" />

                        <!-- 生日歌。这个开关同时管自动化行动里的「发送生日提醒」，
                             所以不随「每天自动发送」一起置灰。 -->
                        <ToggleSwitch Content="提醒时播放生日歌"
                                      IsChecked="{Binding Reminder.IsSongEnabled}" />

                        <StackPanel Spacing="6" IsEnabled="{Binding Reminder.IsSongEnabled}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="播放时长" VerticalAlignment="Center" Width="72" />
                                <ComboBox Width="140"
                                          ItemsSource="{Binding SongDurationLabels}"
                                          SelectedIndex="{Binding SelectedSongDurationIndex}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="音乐文件" VerticalAlignment="Center" Width="72" />
                                <TextBox Text="{Binding SongPathDisplay}" IsReadOnly="True"
                                         Width="320" VerticalAlignment="Center" />
                                <Button Content="选择…" Command="{Binding PickSongCommand}" />
                                <Button Content="恢复默认" Command="{Binding ResetSongCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,4" />

                    <!-- 手动播放/停止：和托盘菜单「更多选项」里那条是同一个开关。
                         刻意放在两个 IsEnabled 之外 —— 提醒没开、或没勾「提醒时播放」时也要能试听。 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="手动控制" VerticalAlignment="Center" Width="72" />
                        <Button Content="{Binding SongToggleText}"
                                Command="{Binding ToggleSongCommand}"
                                Width="120" />
                        <TextBlock Text="（也可以在托盘菜单「更多选项」里操作）"
                                   VerticalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 闰日处理 -->
            <StackPanel Spacing="4">
                <TextBlock Text="闰日（2 月 29 日）在非闰年怎么显示" FontWeight="SemiBold" />
                <ComboBox Width="300"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding LeapDayOptions}"
                          SelectedItem="{Binding SelectedLeapDayOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LeapDayOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- 导入错误列表 -->
            <StackPanel Spacing="4"
                        IsVisible="{Binding HasImportErrors}">
                <TextBlock Text="导入失败明细" FontWeight="SemiBold" Foreground="OrangeRed" />
                <ItemsControl ItemsSource="{Binding ImportErrors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="OrangeRed" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 今日生日 -->
            <StackPanel Spacing="4">
                <TextBlock Text="今日生日" FontWeight="SemiBold" />
                <TextBlock Text="今天没有同学过生日。" Opacity="0.6"
                           IsVisible="{Binding !HasTodayBirthdays}" />
                <ItemsControl ItemsSource="{Binding TodayBirthdays}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BirthdayPerson">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding Name}" Width="120" />
                                <TextBlock Text="{Binding Birthday, StringFormat='{}{0:MM-dd}'}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 生日名单 -->
            <Border BorderThickness="1" CornerRadius="6" Padding="12"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                <StackPanel Spacing="8">
                    <DockPanel>
                        <TextBlock Text="生日名单" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VisibleCountText}" Opacity="0.7"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                        <Button Content="导出 CSV" HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Command="{Binding ExportCsvCommand}" />
                    </DockPanel>

                    <TextBox Watermark="搜索姓名 / 班级 / 备注"
                             Text="{Binding SearchText}" />

                    <!-- 固定高度 + 内部滚动：名单再长也不会把设置页撑成一条长龙 -->
                    <ScrollViewer MaxHeight="320">
                        <ItemsControl ItemsSource="{Binding VisiblePeople}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:BirthdayPerson">
                                    <Grid ColumnDefinitions="2*,1.2*,2*,2*,Auto" Margin="0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Birthday, StringFormat='{}{0:MM-dd}'}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding ClassName}"
                                                   VerticalAlignment="Center" Opacity="0.8"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Remark}"
                                                   VerticalAlignment="Center" Opacity="0.8"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                                            <Button Content="编辑" Padding="8,2"
                                                    Command="{Binding $parent[ItemsControl].((vm:BirthdaySettingsPageViewModel)DataContext).EditPersonCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Padding="8,2"
                                                    Command="{Binding $parent[ItemsControl].((vm:BirthdaySettingsPageViewModel)DataContext).DeletePersonCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="名单为空。点上面的「导入表格」导入 .xlsx 或 .csv。"
                               Opacity="0.6"
                               IsVisible="{Binding !HasVisiblePeople}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
