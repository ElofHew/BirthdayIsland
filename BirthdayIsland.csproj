<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>BirthdayIsland</RootNamespace>
		<AssemblyName>BirthdayIsland</AssemblyName>
		<!-- 必须：允许程序集作为插件被动态加载，并将依赖 DLL 与 .deps.json 输出到 bin 目录 -->
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<!-- 插件版本号 -->
		<Version>2.6.0.0</Version>
		<AssemblyVersion>2.6.0.0</AssemblyVersion>
		<FileVersion>2.6.0.0</FileVersion>
		<!-- 与 XAML 中的 x:DataType 编译期绑定配合 -->
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<!-- 宿主源码在仓库外面两级：本插件放在 ClassIsland/plugins/BirthdayIsland。
		     原模板用的是 PackageReference ClassIsland.PluginSdk 1.7.106.2-dev-v2，但这个版本
		     在任何 NuGet 源上都不存在（镜像里只有 2.0.1 ~ 2.1.2），还原必然失败。
		     改成源码引用：PluginSdk 本质上只是把 ClassIsland.Core 转手一次，直接引 Core 等价，
		     而且不需要联网、不会出现「插件 SDK 版本和宿主版本对不上」的问题。
		     Private=false：Core 由宿主加载，插件包绝不能自带一份，否则类型身份会分裂。 -->
		<ProjectReference Include="..\..\ClassIsland.Core\ClassIsland.Core.csproj"
		                  Private="false" ExcludeAssets="runtime" />
		<!-- MVVM 工具：ObservableObject / RelayCommand 源生成器 -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<!-- Excel(.xlsx) 解析。注意它只认 OpenXML，打不开老的 .xls 二进制格式，所以导入入口只放行 xlsx / csv。 -->
		<PackageReference Include="ClosedXML" Version="0.104.2" />
	</ItemGroup>

	<!-- 随插件一起打包的资源文件 -->
	<ItemGroup>
		<None Update="manifest.yml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!-- 生日歌随插件一起分发。源码放在 Assets/ 里便于管理，构建时用 Link 平铺到输出目录根部，
		     运行时按「程序集所在目录 + BirthdaySong.mp3」去找，打包脚本再按文件名收进 .cipx。
		     CopyToOutputDirectory 用 Always 而不是 PreserveNewest：MSBuild 复制会连源文件的
		     修改时间一起带过去，「输出比源新」的判断可能在改过素材后仍然成立，于是静默跳过复制，
		     打出来的包里还是上一版音频（manifest 上踩过同样的坑，见 build.ps1 的同步步骤）。 -->
		<None Include="Assets\BirthdaySong.mp3" Link="BirthdaySong.mp3">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>